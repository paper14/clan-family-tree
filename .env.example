APP_NAME="Clan Family Tree"
# Everyday use: production and no debug, even though it's local (docs/architecture-local.md §2).
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL 8, utf8mb4 / utf8mb4_0900_ai_ci (accent- and case-insensitive search).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clan_registry
DB_USERNAME=clan_app
DB_PASSWORD=
DB_COLLATION=utf8mb4_0900_ai_ci

# The real registry. Destructive commands (migrate:fresh, db:wipe, db:seed …) are refused
# against it, and plain "migrate" is refused too: use php artisan app:migrate.
CLAN_REGISTRY_DATABASE=clan_registry
# Seeders and the sample clans go here, never into the registry.
DB_DEMO_DATABASE=clan_demo

# Backups: a folder OUTSIDE the project, ideally on another drive or a synced folder.
CLAN_BACKUP_PATH='C:\Users\YOU\Documents\ClanFamilyTree-backups'
CLAN_BACKUP_KEEP_AUTO=20
CLAN_MYSQLDUMP_PATH='C:\Program Files\MySQL\MySQL Server 8.0\bin\mysqldump.exe'
CLAN_MYSQL_PATH='C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe'

SESSION_DRIVER=file
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file
MAIL_MAILER=log
